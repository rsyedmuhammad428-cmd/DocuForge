{
  "name": "docuforge-desktop",
  "productName": "DocuForge",
  "version": "0.5.0",
  "description": "Free, open-source, offline-first PDF and document tools for Windows.",
  "author": "DocuForge contributors",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dist": "npm run build && npm run engine:build && npm run notices && electron-builder --win --x64",
    "engine:setup": "node scripts/setup-engine.mjs",
    "engine:test": "node scripts/test-engine.mjs",
    "test:all": "npm test && npm run engine:test",
    "engine:check": "node scripts/check-engine.mjs",
    "engine:build": "node scripts/build-engine.mjs",
    "notices": "node scripts/make-license.mjs && node scripts/generate-notices.mjs",
    "icons": "python-engine/.venv/bin/python scripts/make-icons.py",
    "engine:smoke": "node scripts/smoke-engine.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rsyedmuhammad428-cmd/DocuForge.git"
  },
  "homepage": "https://github.com/rsyedmuhammad428-cmd/DocuForge",
  "bugs": {
    "url": "https://github.com/rsyedmuhammad428-cmd/DocuForge/issues"
  }
}
